---
// Simple SSR test page - no WordPress dependency
const timestamp = new Date().toISOString()
const hasWordPressUrl = !!import.meta.env.PUBLIC_WORDPRESS_URL
const wordpressUrl = import.meta.env.PUBLIC_WORDPRESS_URL || 'NOT_SET'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>SSR Test</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        max-width: 800px;
        margin: 2rem auto;
        padding: 2rem;
        background: #f5f5f5;
      }
      .status {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .success {
        color: #22c55e;
        font-size: 2rem;
        margin-bottom: 1rem;
      }
      .info {
        margin: 0.5rem 0;
      }
      code {
        background: #e5e7eb;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <div class='status'>
      <div class='success'>✅ SSR is Working!</div>
      <div class='info'>
        <strong>Timestamp:</strong>
        <code>{timestamp}</code>
      </div>
      <div class='info'>
        <strong>WordPress URL Set:</strong>
        <code>{hasWordPressUrl ? 'YES' : 'NO'}</code>
      </div>
      <div class='info'>
        <strong>WordPress URL:</strong>
        <code>{wordpressUrl}</code>
      </div>
      <div class='info'>
        <strong>Production Mode:</strong>
        <code>{import.meta.env.PROD ? 'YES' : 'NO'}</code>
      </div>
      <div class='info' style='margin-top: 1rem;'>
        <a href='/' style='color: #3b82f6; text-decoration: none;'
          >← Back to Home</a
        >
      </div>
    </div>
  </body>
</html>
