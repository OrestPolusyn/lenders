---
import CalculatorBlock from '@/components/Calculator/Calculator.astro'
import Footer from '@/components/Footer/Footer.astro'
import GetInTouch from '@/components/GetInTouch/GetInTouch.astro'
import Header from '@/components/Header/Header.astro'
import PageHeader from '@/components/PageHeader/PageHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPageBySlug } from '@/lib/wordpress'

// Fetch WordPress data for Calculator page
const calculatorPage = await getPageBySlug('calculator')
const acf = calculatorPage?.acf || {}

const pageTitle = calculatorPage?.title?.rendered || 'Calculator'
const metaTitle = calculatorPage?.title?.rendered || 'The Lenders - Calculator'
const metaDescription =
  calculatorPage?.excerpt?.rendered ||
  'Calculate your mortgage payments with our interactive calculator. Compare different loan programs and see your monthly payment breakdown.'
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <Header />

  <main class='main'>
    <PageHeader title={pageTitle} />
    <CalculatorBlock data={acf} />
    {acf.calculator_cta_enabled !== false && <GetInTouch data={acf} />}
  </main>

  <Footer />
</BaseLayout>
