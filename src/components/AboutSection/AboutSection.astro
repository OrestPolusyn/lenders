---
import ProgressLines from '../ProgressLines/ProgressLines.astro'
import styles from './AboutSection.module.css'
import aboutImage from '/public/images/home/about-men.jpg'
import calculateImage from '/public/images/home/calculate.jpg'
import LazyImage from '../UI/LazyImage/LazyImage.astro'

interface ProgressItem {
  title: string
  percent: number
  label: string
}

interface Props {
  data?: {
    about_slogan?: string
    about_title?: string
    about_description?: string
    about_years?: number
    about_button_text?: string
    about_button_url?: string
    about_progress_lines?: ProgressItem[]
  }
}

const { data = {} } = Astro.props

const aboutData = {
  slogan: data.about_slogan || 'Welcome to The Lenders',
  title: data.about_title || 'our loans will fill yourdreams come true',
  description:
    data.about_description ||
    'We provide simple, transparent, and stress-free mortgage solutions tailored to your financial goals. Choose from Conventional, FHA, VA, Jumbo, First-Time Buyer loans — with expert support at every step.',
  years: data.about_years || 25,
  buttonText: data.about_button_text || 'Explore Loans',
  buttonUrl: data.about_button_url || '/loans',
  progressLines: data.about_progress_lines || [],
}
---

<section class={styles.aboutSection}>
  <div class='container'>
    <div class={`${styles.aboutSectionWrapper} wrapper`}>
      <div class={styles.aboutSectionImages}>
        <LazyImage
          class={styles.aboutSectionImageFirst}
          src={aboutImage.src}
          alt='About'
          width={aboutImage.width}
          height={aboutImage.height}
          loading='lazy'
        />
        <LazyImage
          class={styles.aboutSectionImageSecond}
          src={calculateImage.src}
          alt='About'
          width={calculateImage.width}
          height={calculateImage.height}
          loading='lazy'
        />

        <div class={styles.aboutSectionInfo}>
          <span class={styles.aboutSectionExperience}>
            years of <br />
            experience
          </span>

          <span
            class={styles.aboutSectionExperienceNumber}
            data-value={aboutData.years}
          >
            0
          </span>
        </div>
      </div>

      <div class={styles.aboutSectionContent}>
        <div class='slogan slogan--reverse'>
          <span>{aboutData.slogan}</span>
        </div>

        <h2>{aboutData.title}</h2>

        <div>
          <p set:html={aboutData.description} />
        </div>

        <ProgressLines items={aboutData.progressLines} />
      </div>
    </div>

    <a class='button' href={aboutData.buttonUrl}>
      <span>{aboutData.buttonText}</span>
    </a>
  </div>
</section>

<script>
  import { animateValue } from '@/utils/helpers'

  const aboutSectionExperienceNumber = document.querySelector(
    '[class*="aboutSectionExperienceNumber"]'
  )

  if (aboutSectionExperienceNumber) {
    const years = parseInt(
      aboutSectionExperienceNumber.getAttribute('data-value') || '0'
    )

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateValue(aboutSectionExperienceNumber, 0, years, 1000)
            observer.unobserve(aboutSectionExperienceNumber)
          }
        })
      },
      {
        threshold: 0.5,
      }
    )

    observer.observe(aboutSectionExperienceNumber)
  }
</script>
