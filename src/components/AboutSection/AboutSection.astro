---
import ProgressLines from '../ProgressLines/ProgressLines.astro'
import styles from './AboutSection.module.css'
import aboutImage from '/public/images/home/about-men.jpg'
import calculateImage from '/public/images/home/calculate.jpg'
---

<section class={styles.aboutSection}>
  <div class='container'>
    <div class={`${styles.aboutSectionWrapper} wrapper`}>
      <div class={styles.aboutSectionImages}>
        <img
          class={styles.aboutSectionImageFirst}
          src={aboutImage.src}
          alt='About'
          width={aboutImage.width}
          height={aboutImage.height}
          loading='lazy'
        />
        <img
          class={styles.aboutSectionImageSecond}
          src={calculateImage.src}
          alt='About'
          width={calculateImage.width}
          height={calculateImage.height}
          loading='lazy'
        />

        <div class={styles.aboutSectionInfo}>
          <span class={styles.aboutSectionExperience}>
            years of <br />
            experience
          </span>

          <span class={styles.aboutSectionExperienceNumber} data-value='25'>
            0
          </span>
        </div>
      </div>

      <div class={styles.aboutSectionContent}>
        <div class='slogan slogan--reverse'>
          <span>Welcome to The Lenders</span>
        </div>

        <h2>our loans will fill yourdreams come true</h2>

        <p>
          We provide simple, transparent, and stress-free mortgage solutions
          tailored to your financial goals. Choose from Conventional, FHA, VA,
          Jumbo, First-Time Buyer loans — with expert support at every step.
        </p>

        <ProgressLines />
      </div>
    </div>

    <a class='button' href='/loans'>
      <span>Explore Loans</span>
    </a>
  </div>
</section>

<script>
  import { animateValue } from '@/utils/helpers'

  const aboutSectionExperienceNumber = document.querySelector(
    '[class*="aboutSectionExperienceNumber"]'
  )

  if (aboutSectionExperienceNumber) {
    const years = parseInt(
      aboutSectionExperienceNumber.getAttribute('data-value') || '0'
    )

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateValue(aboutSectionExperienceNumber, 0, years, 1000)
            observer.unobserve(aboutSectionExperienceNumber)
          }
        })
      },
      {
        threshold: 0.5,
      }
    )

    observer.observe(aboutSectionExperienceNumber)
  }
</script>
