---
import LoansGrid from '@/components/LoansGrid/LoansGrid.astro'
import LoanDescription from '../LoanDescription/LoanDescription.astro'
import styles from './LoanList.module.css'
---

<section class={styles.loanList}>
  <div class='container'>
    <div class={styles.loanListWrapper}>
      <h2>Loan Categories Overview</h2>
      <p>
        Explore flexible, competitive mortgage programs designed to support
        first-time buyers, veterans, investors, and experienced homeowners.
      </p>
    </div>

    <LoansGrid />

    <LoanDescription />
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const grid = document.querySelector('.loanGrid') as HTMLElement | null
      const descriptionSection = document.querySelector(
        '[data-loan-description]'
      ) as HTMLElement | null

      if (!grid || !descriptionSection) return

      const descriptionBlocks =
        descriptionSection.querySelectorAll('[data-loan-block]')

      const backButton = descriptionSection.querySelector(
        '[data-loan-back]'
      ) as HTMLButtonElement | null

      // Hide description initially
      descriptionSection.style.display = 'none'
      descriptionSection.style.opacity = '0'
      descriptionBlocks.forEach(block => {
        ;(block as HTMLElement).style.display = 'none'
      })

      const openLoan = (loanSlug: string) => {
        if (!loanSlug) return

        // Hide grid, show description section
        grid.style.display = 'none'
        descriptionSection.style.display = 'block'

        // Trigger fade-in
        requestAnimationFrame(() => {
          descriptionSection.style.opacity = '1'
        })

        descriptionBlocks.forEach(block => {
          const el = block as HTMLElement
          const value = el.getAttribute('data-loan-block')
          el.style.display = value === loanSlug ? 'block' : 'none'
        })
      }

      const showAllPrograms = () => {
        // Show grid, hide description section and all description blocks
        grid.style.display = 'grid'
        descriptionSection.style.opacity = '0'
        descriptionSection.style.display = 'none'

        descriptionBlocks.forEach(block => {
          ;(block as HTMLElement).style.display = 'none'
        })
      }

      // Open from query param on initial load, e.g. /loan-programs?loan=conventional
      const params = new URLSearchParams(window.location.search)
      const initialLoan = params.get('loan')
      if (initialLoan) {
        openLoan(initialLoan)
      }

      if (backButton) {
        backButton.addEventListener('click', () => {
          showAllPrograms()
        })
      }

      grid.addEventListener('click', event => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return

        const item = target.closest('.loanGridItem')
        if (!item) return

        const loanSlug = item.getAttribute('data-loan')
        if (!loanSlug) return

        openLoan(loanSlug)
      })
    })
  }
</script>
