---
import LoansGrid from '@/components/LoansGrid/LoansGrid.astro'
import LoanDescription from '../LoanDescription/LoanDescription.astro'
import styles from './LoanList.module.css'
---

<section class={styles.loanList}>
  <div class='container'>
    <div class={styles.loanListWrapper} data-loans>
      <p>
        At The Lenders, we offer a comprehensive suite of mortgage solutions
        built to match your goals, lifestyle, and financial path. Whether you're
        buying your first home, upgrading, investing, or refinancing — we
        provide guidance where homeownership begins.
      </p>
    </div>

    <div class={styles.loanListInner}>
      <LoansGrid />

      <LoanDescription />
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const grid = document.querySelector('.loanGrid') as HTMLElement | null
      const loansContainer = document.querySelector(
        '[data-loans]'
      ) as HTMLElement | null
      const descriptionSection = document.querySelector(
        '[data-loan-description]'
      ) as HTMLElement | null

      if (!grid || !descriptionSection) return

      const descriptionBlocks =
        descriptionSection.querySelectorAll('[data-loan-block]')

      const backButtons =
        descriptionSection.querySelectorAll('[data-loan-back]')

      // Hide description initially
      descriptionBlocks.forEach(block => {
        ;(block as HTMLElement).classList.add('loan-description-hidden')
      })

      const openLoan = (loanSlug: string, target: HTMLElement) => {
        if (!loanSlug) return

        const loanTarget = target.closest('li')

        // Hide grid, show description section
        grid.querySelectorAll('li').forEach(item => {
          if (item === loanTarget) {
            item?.classList.add('active-loan')
          } else {
            item.classList.add('hide-loan')
          }
        })

        grid.classList.add('hide-grid')
        descriptionSection.classList.add('data-visible')

        descriptionBlocks.forEach(block => {
          const el = block as HTMLElement
          const value = el.getAttribute('data-loan-block')
          el.classList.toggle('loan-description-hidden', value !== loanSlug)
        })
        setTimeout(() => {
          window.scrollTo({
            top: loansContainer?.offsetTop || 0,
            behavior: 'smooth',
          })
        }, 1200)
      }

      const showAllPrograms = () => {
        // Show grid, hide description section and all description blocks
        grid.querySelectorAll('li').forEach(item => {
          item.classList.remove('hide-loan', 'active-loan')
        })
        grid.classList.remove('hide-grid')

        descriptionSection.classList.remove('data-visible')

        descriptionBlocks.forEach(block => {
          ;(block as HTMLElement).classList.add('loan-description-hidden')
        })

        setTimeout(() => {
          window.scrollTo({
            top: loansContainer?.offsetTop - 200 || 0,
            behavior: 'smooth',
          })
        }, 1200)
      }

      // Open from query param on initial load, e.g. /loan-programs?loan=conventional
      const params = new URLSearchParams(window.location.search)
      const initialLoan = params.get('loan')
      if (initialLoan) {
        openLoan(initialLoan, grid)
      }

      if (backButtons.length > 0) {
        backButtons.forEach(button => {
          button.addEventListener('click', () => {
            showAllPrograms()
          })
        })
      }

      grid.addEventListener('click', event => {
        const target = event.target
        if (!(target instanceof HTMLElement)) return

        const item = target.closest('.loanGridItem')
        if (!item) return

        const loanSlug = item.getAttribute('data-loan')
        if (!loanSlug) return

        openLoan(loanSlug, target)
      })
    })
  }
</script>
