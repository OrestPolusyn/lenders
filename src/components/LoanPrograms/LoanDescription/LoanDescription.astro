---
import loansData from '@/data/loans.json'
import styles from './LoanDescription.module.css'

interface Props {
  loanPrograms?: any[]
}

const { loanPrograms } = Astro.props

// Map WordPress programs (simple structure: slug, title, description)
const loans =
  loanPrograms && loanPrograms.length > 0
    ? loanPrograms.map((program: any) => ({
        slug: program.slug,
        title: program.title,
        description: program.description || '',
      }))
    : (loansData as any[])
---

<section class={styles.loanDescription} data-loan-description>
  <div class='container'>
    <button
      type='button'
      class={`button button--back ${styles.loanDescriptionBack}`}
      data-loan-back
    >
      <span>Back to all programs</span>
    </button>

    {
      loans.map((loan: any) => (
        <div class={styles.loanDescriptionWrapper} data-loan-block={loan.slug}>
          <h2>{loan.title}</h2>
          <div class='wordpress-content' set:html={loan.description} />
        </div>
      ))
    }

    <button
      type='button'
      class={`button button--back ${styles.loanDescriptionBack}`}
      data-loan-back
    >
      <span>Back to all programs</span>
    </button>
  </div>
</section>
