---
import LoansGrid from '@/components/LoansGrid/LoansGrid.astro'
import styles from './Calculator.module.css'
import calculatorImage from '/public/images/home/calculator.png'
---

<section class={styles.homeCalculator}>
  <div class='container'>
    <div class={styles.homeCalculatorContent}>
      <div class='slogan slogan--double'>
        <span>calculate your loan</span>
      </div>

      <h2>Mortgage Programs Tailored for Every Dream</h2>

      <p>
        Use our calculator to estimate your monthly payments and explore our
        flexible mortgage programs designed to match your unique needs.
      </p>
    </div>

    <div class={styles.homeCalculatorWrapper}>
      <div class={styles.homeCalculatorImages}>
        <img
          src={calculatorImage.src}
          alt='About'
          width={404}
          height={616}
          loading='lazy'
        />
      </div>

      <LoansGrid numberOfItems={4} linkToLoanPrograms={true} />
    </div>
  </div>
</section>
