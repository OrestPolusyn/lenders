---
import styles from './Calculator.module.css'
import calculatorImage from '/public/images/home/calculator.png'

const loanList = [
  {
    title: 'Conventional Loans',
    icon: 'conventional',
  },
  {
    title: 'FHA Loans',
    icon: 'fha',
  },
  {
    title: 'VA Loans',
    icon: 'va',
  },
  {
    title: 'USDA Loans',
    icon: 'usda',
  },
  {
    title: 'Jumbo Loans',
    icon: 'jumbo',
  },
  {
    title: 'HELOC (Home Equity)',
    icon: 'heloc',
  },
  {
    title: 'Rehab / Investment Property',
    icon: 'rehab-investment',
  },
  {
    title: 'Zero Downpayment Options',
    icon: 'zero-downpayment',
  },
  {
    title: 'Self-Employed Programs',
    icon: 'self-employed',
  },
]
---

<section class={styles.homeCalculator}>
  <div class='container'>
    <div class={styles.homeCalculatorContent}>
      <div class='slogan slogan--double'>
        <span>calculate your loan</span>
      </div>

      <h2>Mortgage Programs Tailored for Every Dream</h2>

      <p>
        Use our calculator to estimate your monthly payments and explore our
        flexible mortgage programs designed to match your unique needs.
      </p>
    </div>

    <div class={styles.homeCalculatorWrapper}>
      <div class={styles.homeCalculatorImages}>
        <img
          src={calculatorImage.src}
          alt='About'
          width={404}
          height={616}
          loading='lazy'
        />
      </div>

      <div class={styles.homeCalculatorGrid}>
        <ul class={styles.homeCalculatorList}>
          {
            loanList.map(loan => (
              <li>
                <a
                  class={`${styles.homeCalculatorListItem} ${styles[`homeCalculatorListItem--${loan.icon}`]}`}
                  href={`/loans/${loan.icon}`}
                >
                  <p>{loan.title}</p>

                  <div class='button'>
                    <span>Read more</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
