---
import styles from './Process.module.css'
import processImageFirst from '/public/images/home/process-first.png'
import processImageFourth from '/public/images/home/process-fourth.png'
import processImageSecond from '/public/images/home/process-second.png'
import processImageThird from '/public/images/home/process-third.png'
---

<section class={styles.process}>
  <div class='container'>
    <div class={styles.processContent}>
      <div class={styles.processHeader}>
        <p class='slogan slogan--double'>how it works</p>

        <h2>our working process</h2>
      </div>

      <ul class={styles.processList}>
        <li class={styles.processItem}>
          <div class={styles.processItemIcons}>
            <img
              src={processImageFirst.src}
              alt='processImageFirst'
              width={130}
              height={130}
            />

            <span class={styles.processStepNumber}>step</span>
            <svg
              class={styles.processItemIconsArrow}
              viewBox='0 0 242 67'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                d='M239.497 33.8939L207.961 65.4318H4L35.5698 33.8939L4 2.35596H207.961L239.497 33.8939Z'
              ></path>
            </svg>
            <svg
              class={styles.processItemIconsCircle}
              width='136'
              height='32'
              viewBox='0 0 136 32'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                d='M67.9555 0.758301C105.486 0.758301 135.894 7.52133 135.894 15.8938C135.894 24.2491 105.469 31.0292 67.9555 31.0292C30.425 31.0292 7.21871e-06 24.2491 7.21871e-06 15.8938C-0.0171143 7.53845 30.425 0.758301 67.9555 0.758301Z'
              ></path>
            </svg>
          </div>

          <h3>Application Submit</h3>
          <p>
            In a few hour, when our power of choice is untrammelled and when
            nothing prevents
          </p>
        </li>
        <li class={styles.processItem}>
          <div class={styles.processItemIcons}>
            <img
              src={processImageSecond.src}
              alt='processImageFirst'
              width={130}
              height={130}
            />

            <span class={styles.processStepNumber}>step</span>
            <svg
              class={styles.processItemIconsArrow}
              viewBox='0 0 242 67'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                d='M239.497 33.8939L207.961 65.4318H4L35.5698 33.8939L4 2.35596H207.961L239.497 33.8939Z'
              ></path>
            </svg>
            <svg
              class={styles.processItemIconsCircle}
              width='136'
              height='32'
              viewBox='0 0 136 32'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                d='M67.9555 0.758301C105.486 0.758301 135.894 7.52133 135.894 15.8938C135.894 24.2491 105.469 31.0292 67.9555 31.0292C30.425 31.0292 7.21871e-06 24.2491 7.21871e-06 15.8938C-0.0171143 7.53845 30.425 0.758301 67.9555 0.758301Z'
              ></path>
            </svg>
          </div>

          <h3>Review & Verification</h3>
          <p>
            Back to the drawing board show. grh So far we should have a clean
            data approach
          </p>
        </li>
        <li class={styles.processItem}>
          <div class={styles.processItemIcons}>
            <img
              src={processImageThird.src}
              alt='processImageFirst'
              width={130}
              height={130}
            />

            <span class={styles.processStepNumber}>step</span>
            <svg
