---
import LazyImage from '../../UI/LazyImage/LazyImage.astro'
import styles from './Philosophy.module.css'
import philosophyImage from '/public/images/home/philosophy-women.jpg'

interface Props {
  data?: {
    philosophy_quote?: string
    philosophy_slogan?: string
    philosophy_title?: string
    philosophy_description?: string
    philosophy_values?: Array<{ title: string; description: string }>
    philosophy_button_text?: string
    philosophy_button_url?: string
  }
}

const { data = {} } = Astro.props

const philosophyData = {
  quote:
    data.philosophy_quote ||
    '"We believe everyone deserves a chance to be approved."',
  slogan: data.philosophy_slogan || 'Mortgage Lending, Elevated.',
  title: data.philosophy_title || 'Why Choose The Lenders',
  description:
    data.philosophy_description ||
    'At The Lenders, we believe every borrower deserves clarity, trust, and a personalized lending experience. Our team combines industry expertise with premium customer care to help you make informed decisions at every stage of the mortgage process.',
  values: data.philosophy_values || [
    { title: 'Transparency', description: 'no hidden fees, no surprises' },
    {
      title: 'Flexibility',
      description: 'loan options designed around your lifestyle',
    },
    {
      title: 'Guidance',
      description: 'expert support from application to closing',
    },
    {
      title: 'Efficiency',
      description: 'faster approvals and streamlined processing',
    },
  ],
  buttonText: data.philosophy_button_text || 'Read Our Story',
  buttonUrl: data.philosophy_button_url || '/about',
}
---

<section class={styles.homePhilosophy}>
  <div class='container'>
    <div class={`${styles.homePhilosophyWrapper} wrapper`}>
      <div class={styles.homePhilosophyImages}>
        <LazyImage
          class={styles.homePhilosophyImage}
          src={philosophyImage.src}
          alt='Philosophy'
          width={495}
          height={500}
          loading='lazy'
        />

        <div class={styles.homePhilosophyInfo}>
          <p>{philosophyData.quote}</p>
        </div>
      </div>

      <div class={styles.homePhilosophyContent}>
        <div class='slogan slogan--reverse'>
          <span>{philosophyData.slogan}</span>
        </div>

        <h2>{philosophyData.title}</h2>

        <p set:html={philosophyData.description} />

        <ul class={styles.homePhilosophyList}>
          {
            philosophyData.values.map(value => (
              <li class={styles.homePhilosophyListItem}>
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <a class='button' href={philosophyData.buttonUrl}>
      <span>{philosophyData.buttonText}</span>
    </a>
  </div>
</section>
