---
import styles from './About.module.css'
import aboutImage from '/public/images/home/about-men.jpg'
import calculateImage from '/public/images/home/calculate.jpg'
---

<section class={styles.homeAbout}>
  <div class='container'>
    <div class={`${styles.homeAboutWrapper} wrapper`}>
      <div class={styles.homeAboutImages}>
        <img
          class={styles.homeAboutImageFirst}
          src={aboutImage.src}
          alt='About'
          width={aboutImage.width}
          height={aboutImage.height}
          loading='lazy'
        />
        <img
          class={styles.homeAboutImageSecond}
          src={calculateImage.src}
          alt='About'
          width={calculateImage.width}
          height={calculateImage.height}
          loading='lazy'
        />

        <div class={styles.homeAboutInfo}>
          <span class={styles.homeAboutExperience}>
            years of <br />
            experience
          </span>

          <span class={styles.homeAboutExperienceNumber} data-value='15'>
            0
          </span>
        </div>
      </div>

      <div class={styles.homeAboutContent}>
        <div class='slogan slogan--reverse'>
          <span>welcome to easiloan</span>
        </div>

        <h2>our loans will fill yourdreams come true</h2>

        <p>
          Lorem Ipsum Dolor Sit Amet, Consectetur Adipisicing Elit, Sed Do
          Eiusmod Tempor Incididunt Ut Labore Et Dolore Magna Aliqua.
        </p>

        <ul class={styles.homeAboutList}>
          <li
            class={`${styles.homeAboutListItem} ${styles.homeAboutListItemFirst}`}
          >
            <p>Quick Loan Process</p>
          </li>

          <li
            class={`${styles.homeAboutListItem} ${styles.homeAboutListItemSecond}`}
          >
            <p>Small Business Loan</p>
          </li>

          <li
            class={`${styles.homeAboutListItem} ${styles.homeAboutListItemThird}`}
          >
            <p>Very Low Rates</p>
          </li>

          <li
            class={`${styles.homeAboutListItem} ${styles.homeAboutListItemFourth}`}
          >
            <p>Studying Abroad Loan</p>
          </li>
        </ul>

        <a class='button' href='/loans'>
          <span>Explore Loans</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { animateValue } from '@/utils/helpers'

  const homeAboutExperienceNumber = document.querySelector(
    '[class*="homeAboutExperienceNumber"]'
  )

  if (homeAboutExperienceNumber) {
    const years = parseInt(
      homeAboutExperienceNumber.getAttribute('data-value') || '0'
    )

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateValue(homeAboutExperienceNumber, 0, years, 1000)
            observer.unobserve(homeAboutExperienceNumber)
          }
        })
      },
      {
        threshold: 0.5,
      }
    )

    observer.observe(homeAboutExperienceNumber)
  }
</script>
