---
import newsData from '@/data/news.json'
import { getAllPosts } from '@/lib/wordpress'
import LazyImage from '../../UI/LazyImage/LazyImage.astro'
import styles from './News.module.css'

interface Props {
  data?: {
    news_slogan?: string
    news_title?: string
    news_button_text?: string
  }
}

const { data = {} } = Astro.props

const newsContentData = {
  slogan: data.news_slogan || 'Smart mortgage tips and rate trends.',
  title: data.news_title || 'news & insights',
  buttonText: data.news_button_text || 'View All News',
}

interface NewsItem {
  id: number
  title: string
  description: string
  date: string
  category: string
  image: string
  slug?: string
}

let news: NewsItem[] = []

// Спробувати завантажити з WordPress
try {
  const wpPosts = await getAllPosts({ per_page: 3, _embed: true })
  if (wpPosts && wpPosts.length > 0) {
    news = wpPosts.map(post => ({
      id: post.id,
      title: post.title.rendered,
      description:
        post.excerpt.rendered.replace(/<[^>]*>/g, '').substring(0, 150) + '...',
      date: post.date,
      category: post._embedded?.['wp:term']?.[0]?.[0]?.name || 'General',
      image:
        post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
        '/images/placeholder.jpg',
      slug: post.slug,
    }))
  }
} catch (error) {
  console.log('📰 Using static news data (WordPress unavailable)')
}

// Fallback до JSON якщо WordPress не працює
if (news.length === 0) {
  news = newsData
}

const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<section class={styles.news}>
  <div class='container'>
    <div class={styles.newsContent}>
      <div class={styles.newsHeader}>
        <p class='slogan slogan--double'>
          {newsContentData.slogan}
        </p>
        <h2>{newsContentData.title}</h2>
      </div>

      <div class={styles.newsSliderWrapper}>
        <div class={styles.newsSlider}>
          {
            news.map(item => (
              <article class={styles.newsItem}>
                <div class={styles.newsItemImage}>
                  <LazyImage
                    src={item.image}
                    alt={item.title}
                    width={400}
                    height={250}
                    loading='lazy'
                  />
                  <span class={styles.newsItemCategory}>{item.category}</span>
                </div>

                <div class={styles.newsItemContent}>
                  <time class={styles.newsItemDate}>
                    {formatDate(item.date)}
                  </time>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <a
                    class={styles.newsItemButton}
                    href={item.slug ? `/post/${item.slug}` : `/post/${item.id}`}
                  >
                    Read More
                    <svg
                      width='20'
                      height='20'
                      viewBox='0 0 20 20'
                      fill='none'
                      xmlns='http://www.w3.org/2000/svg'
                    >
                      <path
                        d='M7.5 15L12.5 10L7.5 5'
                        stroke='currentColor'
                        stroke-width='2'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <a href='/blog' class='button'>
        <span>{newsContentData.buttonText}</span>
      </a>
    </div>
  </div>
</section>
