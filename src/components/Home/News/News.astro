---
import newsData from '@/data/news.json'
import styles from './News.module.css'

interface NewsItem {
  id: number
  title: string
  description: string
  date: string
  category: string
  image: string
}

const news: NewsItem[] = newsData

const formatDate = (dateString: string) => {
  const date = new Date(dateString)
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<section class={styles.news}>
  <div class='container'>
    <div class={styles.newsContent}>
      <div class={styles.newsHeader}>
        <p class='slogan slogan--double'>
          Smart mortgage tips and rate trends.
        </p>
        <h2>news & insights</h2>
      </div>

      <div class={styles.newsSliderWrapper}>
        <div class={styles.newsSlider}>
          {
            news.map(item => (
              <article class={styles.newsItem}>
                <div class={styles.newsItemImage}>
                  <img src={item.image} alt={item.title} />
                  <span class={styles.newsItemCategory}>{item.category}</span>
                </div>

                <div class={styles.newsItemContent}>
                  <time class={styles.newsItemDate}>
                    {formatDate(item.date)}
                  </time>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <a class={styles.newsItemButton} href={`/post/${item.id}`}>
                    Read More
                    <svg
                      width='20'
                      height='20'
                      viewBox='0 0 20 20'
                      fill='none'
                      xmlns='http://www.w3.org/2000/svg'
                    >
                      <path
                        d='M7.5 15L12.5 10L7.5 5'
                        stroke='currentColor'
                        stroke-width='2'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <a href='/news' class='button'>
        <span>View All News</span>
      </a>
    </div>
  </div>
</section>
