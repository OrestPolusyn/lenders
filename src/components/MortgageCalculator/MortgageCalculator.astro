---
import styles from './MortgageCalculator.module.css'

const defaultPrice = 400000
const defaultDownPayment = 20
const defaultRate = 6.5
const defaultTerm = 30
---

<div class={styles.mortgageCalculator} data-mortgage-calculator>
  <form class={styles.mortgageCalculatorForm} onsubmit='event.preventDefault()'>
    <div class={styles.mortgageCalculatorGrid}>
      <label class={styles.mortgageCalculatorField}>
        <span>Home price</span>
        <div class={styles.mortgageCalculatorValueRow}>
          <span class={styles.mortgageCalculatorValueLabel} data-display-price>
            ${defaultPrice.toLocaleString('en-US')}
          </span>
        </div>
        <input
          type='range'
          name='price'
          min='50000'
          max='1500000'
          step='5000'
          value={defaultPrice}
        />
      </label>

      <label class={styles.mortgageCalculatorField}>
        <span>Down payment</span>
        <div class={styles.mortgageCalculatorValueRow}>
          <span class={styles.mortgageCalculatorValueLabel} data-display-down>
            {defaultDownPayment}%
          </span>
        </div>
        <input
          type='range'
          name='downPayment'
          min='0'
          max='50'
          step='1'
          value={defaultDownPayment}
        />
      </label>

      <label class={styles.mortgageCalculatorField}>
        <span>Interest rate</span>
        <div class={styles.mortgageCalculatorValueRow}>
          <span class={styles.mortgageCalculatorValueLabel} data-display-rate>
            {defaultRate}%
          </span>
        </div>
        <input
          type='range'
          name='rate'
          min='1'
          max='15'
          step='0.1'
          value={defaultRate}
        />
      </label>

      <label class={styles.mortgageCalculatorField}>
        <span>Loan term</span>
        <div class={styles.mortgageCalculatorValueRow}>
          <span class={styles.mortgageCalculatorValueLabel} data-display-term>
            {defaultTerm} years
          </span>
        </div>
        <input
          type='range'
          name='term'
          min='10'
          max='30'
          step='5'
          value={defaultTerm}
        />
      </label>
    </div>

    <div class={styles.mortgageCalculatorResults}>
      <div>
        <span class={styles.mortgageCalculatorResultsLabel}
          >Estimated monthly payment</span
        >
        <div class={styles.mortgageCalculatorPayment} data-mortgage-payment>
          $0
        </div>
      </div>
      <div class={styles.mortgageCalculatorMeta}>
        <span>loan amount</span>

        <span data-mortgage-loan-amount>$0 </span>
      </div>
    </div>
  </form>

  <button class='button'>
    <span>Apply Now</span>
  </button>
</div>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('[data-mortgage-calculator]')
      if (!root) return

      const form = root.querySelector('form') as HTMLFormElement | null
      if (!form) return

      const paymentEl = root.querySelector(
        '[data-mortgage-payment]'
      ) as HTMLElement | null
      const loanAmountEl = root.querySelector(
        '[data-mortgage-loan-amount]'
      ) as HTMLElement | null

      const priceInput = form.elements.namedItem('price') as HTMLInputElement
      const downPaymentInput = form.elements.namedItem(
        'downPayment'
      ) as HTMLInputElement
      const rateInput = form.elements.namedItem('rate') as HTMLInputElement
      const termInput = form.elements.namedItem('term') as HTMLInputElement

      const formatCurrency = (value: number) => {
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0,
        }).format(value)
      }

      const priceDisplay = root.querySelector(
        '[data-display-price]'
      ) as HTMLElement | null
      const downDisplay = root.querySelector(
        '[data-display-down]'
      ) as HTMLElement | null
      const rateDisplay = root.querySelector(
        '[data-display-rate]'
      ) as HTMLElement | null
      const termDisplay = root.querySelector(
        '[data-display-term]'
      ) as HTMLElement | null

      const calculate = () => {
        const price = Number(priceInput.value) || 0
        const downPercent = Number(downPaymentInput.value) || 0
        const rate = Number(rateInput.value) || 0
        const termYears = Number(termInput.value) || 30

        const downPayment = (price * downPercent) / 100
        const loanAmount = Math.max(price - downPayment, 0)

        const monthlyRate = rate / 100 / 12
        const totalMonths = termYears * 12

        let monthlyPayment = 0

        if (monthlyRate > 0 && totalMonths > 0 && loanAmount > 0) {
          const factor = Math.pow(1 + monthlyRate, totalMonths)
          monthlyPayment = (loanAmount * monthlyRate * factor) / (factor - 1)
        }

        if (priceDisplay) {
          priceDisplay.textContent = formatCurrency(price)
        }

        if (downDisplay) {
          downDisplay.textContent = `${downPercent.toFixed(0)}%`
        }

        if (rateDisplay) {
          rateDisplay.textContent = `${rate.toFixed(2)}%`
        }

        if (termDisplay) {
          termDisplay.textContent = `${termYears} years`
        }

        if (paymentEl) {
          paymentEl.textContent =
            monthlyPayment > 0 ? formatCurrency(monthlyPayment) : '$0'
        }

        if (loanAmountEl) {
          loanAmountEl.textContent = `${formatCurrency(loanAmount)}`
        }
      }

      form.addEventListener('input', () => {
        calculate()
      })

      calculate()
    })
  }
</script>
