---
import styles from "./Start.module.css";
---

<section class={styles.Start}>
  <div class="container">
    <div class={styles.StartContent}>
      <div class="slogan slogan--double">
        <span>start</span>
      </div>

      <h2>Ready to Get Started?</h2>

      <p>Let's discuss how we can help you achieve your homeownership goals.</p>

      <div class={styles.StartActions}>
        <a class="button button--colored" href="/contact">
          <span>Contact Us</span>
        </a>
        <a class="button button--reverse" href="/calculator">
          <span>Calculate Your Loan</span>
        </a>
      </div>
    </div>
  </div>
</section>
