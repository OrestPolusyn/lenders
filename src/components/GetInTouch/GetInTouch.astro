---
import styles from './GetInTouch.module.css'
---

<section class={styles.getInTouch}>
  <div class='container'>
    <div class={styles.getInTouchContent}>
      <svg
        width='90'
        height='90'
        viewBox='0 0 90 90'
        fill='none'
        xmlns='http://www.w3.org/2000/svg'
      >
        <path
          d='M0 45C0 20.1472 20.1472 0 45 0C69.8528 0 90 20.1472 90 45C90 69.8528 69.8528 90 45 90C20.1472 90 0 69.8528 0 45Z'
          fill='#FFD700'
          fill-opacity='0.2'></path>
        <path
          d='M28.1099 53.1407C28.3856 53.8361 28.447 54.5982 28.2862 55.3288L26.2893 61.4976C26.2249 61.8104 26.2416 62.1345 26.3376 62.4391C26.4336 62.7437 26.6059 63.0187 26.838 63.2381C27.0702 63.4574 27.3545 63.6139 27.664 63.6925C27.9736 63.7712 28.2981 63.7695 28.6068 63.6876L35.0062 61.8163C35.6956 61.6795 36.4097 61.7393 37.0668 61.9888C41.0706 63.8586 45.6062 64.2542 49.8733 63.1058C54.1404 61.9574 57.8648 59.3388 60.3893 55.712C62.9139 52.0852 64.0764 47.6833 63.6717 43.283C63.267 38.8826 61.3212 34.7666 58.1775 31.661C55.0339 28.5555 50.8944 26.6601 46.4894 26.3092C42.0844 25.9583 37.697 27.1745 34.1014 29.7432C30.5057 32.3119 27.9328 36.0679 26.8366 40.3487C25.7404 44.6295 26.1914 49.16 28.1099 53.1407Z'
          stroke='#FFD700'
          stroke-width='3.75'
          stroke-linecap='round'
          stroke-linejoin='round'></path>
      </svg>

      <h2>Have Questions?</h2>

      <p>
        We're here to help! Text or call us to schedule an appointment with one
        of our mortgage specialists. Get personalized guidance without the wait.
      </p>

      <div class={styles.getInTouchActions}>
        <button class='button button--reverse' data-open-sidebar>
          <span>Contact Us</span>
        </button>
      </div>
    </div>
  </div>
</section>
