---
import styles from './glossary.module.css'

interface GlossaryTerm {
  id: number
  term: string
  letter: string
  definition: string
}

interface Props {
  terms?: GlossaryTerm[]
  sectionTitle?: string
  sectionSubtitle?: string
}

const {
  terms = [],
  sectionTitle = 'Mortgage terms explained',
  sectionSubtitle = 'Please click on the letter below to skip to the definition of the word you are looking for.',
} = Astro.props

// Fallback terms якщо WordPress недоступний (кілька прикладів)
const defaultTerms: GlossaryTerm[] = [
  {
    id: 1,
    term: 'Mortgage',
    letter: 'M',
    definition:
      'A loan used to purchase real estate, where the property serves as collateral for the loan.',
  },
  {
    id: 2,
    term: 'APR',
    letter: 'A',
    definition:
      'Annual Percentage Rate - An interest rate reflecting the cost of a mortgage as a yearly rate.',
  },
  {
    id: 3,
    term: 'Amortization',
    letter: 'A',
    definition:
      'The process of paying off debt over time in equal installments.',
  },
  {
    id: 4,
    term: 'Closing',
    letter: 'C',
    definition:
      'The meeting between the buyer, seller and lender where the property and funds legally change hands.',
  },
  {
    id: 5,
    term: 'Down Payment',
    letter: 'D',
    definition:
      'Money paid to make up the difference between the purchase price and mortgage amount.',
  },
]

// Use WordPress data or fallback
const glossaryTerms = terms.length > 0 ? terms : defaultTerms

// Group terms by letter
const termsByLetter: Record<string, GlossaryTerm[]> = {}
glossaryTerms.forEach(term => {
  const letter = term.letter.toUpperCase()
  if (!termsByLetter[letter]) {
    termsByLetter[letter] = []
  }
  termsByLetter[letter].push(term)
})

// Get unique letters that have terms (sorted)
const availableLetters = Object.keys(termsByLetter).sort()

// All letters A-Z for navigation
const allLetters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
---

<section class={styles.glossary}>
  <div class='container'>
    <div class={styles.glossaryContent}>
      <h2>{sectionTitle}</h2>
      <p>{sectionSubtitle}</p>
    </div>

    <div class={styles.glossaryLetters}>
      {
        allLetters.map(letter => {
          const hasTerms = availableLetters.includes(letter)
          return hasTerms ? (
            <a href={`#${letter}`} class={styles.glossaryLetter}>
              {letter}
            </a>
          ) : (
            <span class={styles.glossaryLetterDisabled}>{letter}</span>
          )
        })
      }
    </div>

    <ul class={styles.glossaryLettersList}>
      {
        availableLetters.map(letter => (
          <>
            {termsByLetter[letter].map((term, index) => (
              <li
                class={styles.glossaryLettersListItem}
                id={index === 0 ? letter : undefined}
              >
                <strong>{term.term}</strong>
                <div set:html={term.definition} />
              </li>
            ))}
          </>
        ))
      }
    </ul>
  </div>
</section>
