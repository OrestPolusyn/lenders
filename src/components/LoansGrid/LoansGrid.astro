---
import { loanList } from '@/const/loansPrograms'
import './LoansGrid.module.css'

interface Props {
  numberOfItems?: number
  linkToLoanPrograms?: boolean
  loanPrograms?: any[]
}

const { numberOfItems, linkToLoanPrograms = false, loanPrograms } = Astro.props

// Використовуємо WordPress дані якщо є, інакше fallback на статичні
const loans =
  loanPrograms && loanPrograms.length > 0
    ? loanPrograms.map(program => ({
        title: program.title,
        icon: program.slug,
      }))
    : loanList

const itemsToShow = numberOfItems || loans.length
---

<ul class='loanGrid'>
  {
    loans.map((loan, index) => {
      if (index < itemsToShow) {
        const href = linkToLoanPrograms
          ? `/loan-programs?loan=${loan.icon}`
          : undefined

        return (
          <li>
            <a
              class={`loanGridItem loanGridItem--${loan.icon}`}
              data-loan={loan.icon}
              href={href}
            >
              <p>{loan.title}</p>

              <div class='button'>
                <span>Read more</span>
              </div>
            </a>
          </li>
        )
      }
    })
  }
</ul>
