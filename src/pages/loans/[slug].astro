---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header/Header.astro";
import Footer from "@/components/Footer/Footer.astro";
import PageHeader from "@/components/PageHeader/PageHeader.astro";
import loansData from "@/data/loans.json";

interface LoanProgram {
  slug: string;
  title: string;
  tagline: string;
  overview: string[];
  features: string[];
  idealFor: string[];
  ctaLabel: string;
  ctaLink: string;
}

const loans: LoanProgram[] = loansData as LoanProgram[];

export async function getStaticPaths() {
  const allLoans = loansData as LoanProgram[];
  return allLoans.map((loan) => ({
    params: { slug: loan.slug },
    props: { loan },
  }));
}

const { loan: loanFromProps } = Astro.props as { loan?: LoanProgram };
const { slug } = Astro.params;

const loan =
  loanFromProps ??
  (loansData as LoanProgram[]).find(
    (program) => program.slug === String(slug),
  );

if (!loan) {
  throw new Error(`Loan program with slug "${slug}" not found`);
}
---

<BaseLayout title={loan.title} description={loan.tagline}>
  <Header />

  <main class="loan">
    <PageHeader title={loan.title} />

    <section class="loan__intro">
      <div class="container">
        <p class="loan__tagline">{loan.tagline}</p>
        {
          loan.overview.map((paragraph) => (
            <p class="loan__paragraph">{paragraph}</p>
          ))
        }
      </div>
    </section>

    <section class="loan__grid">
      <div class="container loan__grid-container">
        <div class="loan__card">
          <h2>Program highlights</h2>
          <ul>
            {loan.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>

        <div class="loan__card">
          <h2>Designed for</h2>
          <ul>
            {loan.idealFor.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="loan__cta">
      <div class="container">
        <h2>Ready to move forward?</h2>
        <p>
          Let's review your goals and outline the next steps to secure the right
          financing.
        </p>
        <a class="loan__cta-button" href={loan.ctaLink}>{loan.ctaLabel}</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .loan__intro {
    padding-block: clamp(32px, 10vw, 80px);
    background: linear-gradient(180deg, #f8faff 0%, #ffffff 100%);
  }

  .loan__tagline {
    font-size: clamp(18px, 2.5vw, 22px);
    color: #1f2937;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .loan__paragraph {
    margin: 0 0 16px;
    color: #4b5563;
    font-size: clamp(16px, 2.2vw, 18px);
    line-height: 1.7;
  }

  .loan__grid {
    padding-block: clamp(32px, 8vw, 72px);
  }

  .loan__grid-container {
    display: grid;
    gap: clamp(24px, 6vw, 40px);
  }

  @media (min-width: 768px) {
    .loan__grid-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .loan__card {
    background: #ffffff;
    border-radius: 20px;
    padding: clamp(24px, 4vw, 32px);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
  }

  .loan__card h2 {
    margin: 0 0 16px;
    font-size: clamp(22px, 3vw, 28px);
    color: #111827;
  }

  .loan__card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
    color: #374151;
    font-size: 16px;
    line-height: 1.6;
  }

  .loan__card li {
    position: relative;
    padding-left: 24px;
  }

  .loan__card li::before {
    content: "•";
    position: absolute;
    left: 8px;
    color: #3949ff;
    font-size: 18px;
    line-height: 1;
  }

  .loan__cta {
    padding-block: clamp(40px, 10vw, 96px);
    background: radial-gradient(
      circle at top right,
      rgba(57, 73, 255, 0.12),
      transparent 60%
    );
    text-align: center;
  }

  .loan__cta h2 {
    margin: 0 0 12px;
    font-size: clamp(26px, 4vw, 36px);
    color: #111827;
  }

  .loan__cta p {
    margin: 0 0 24px;
    color: #4b5563;
    font-size: clamp(16px, 2.2vw, 18px);
  }

  .loan__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: 999px;
    background: #3949ff;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 12px 24px rgba(57, 73, 255, 0.35);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .loan__cta-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 34px rgba(57, 73, 255, 0.4);
  }
</style>

