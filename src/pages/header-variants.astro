            </div>
            <p class='header-variant__label'>Variant 3</p>
          </div>

          <!-- Current header background + Logo 2 -->
          <div class='header-variant'>
            <div class='header-variant__bar header-variant__bar--current'>
              <img
                src='/images/logo_2.svg'
                alt='Logo 2 on current header background'
                class='header-variant__logo'
              />
              <nav class='header-variant__nav'>
                <span></span>
                <span></span>
                <span></span>
              </nav>
            </div>
            <p class='header-variant__label'>
              Variant 2 — current background + Logo 2
