              Variant 17 — light header + Logo 3
            </p>
          </div>

          <!-- Solid blue header + Logo 3 -->
          <div class='header-variant'>
            <div class='header-variant__bar header-variant__bar--solid-blue'>
              <img
                src='/images/logo_3.svg'
                alt='Logo variant 3 on solid blue background'
                class='header-variant__logo'
              />
              <nav class='header-variant__nav'>
                <span></span>
                <span></span>
                <span></span>
              </nav>
            </div>
            <p class='header-variant__label'>
              Variant 18 — solid blue + Logo 3
            </p>
          </div>

          <!-- Soft blue header + Logo 3 -->
          <div class='header-variant'>
            <div class='header-variant__bar header-variant__bar--blue-soft'>
