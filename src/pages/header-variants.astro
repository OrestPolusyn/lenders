        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .header-variants {
    padding-block: clamp(2rem, 3vw, 3rem);
    background-color: transparent;
  }

  .header-variants__title {
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--color-blue-600);
  }

  .header-variants__subtitle {
    text-align: center;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-blue-400);
  }

  .header-variants__grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .header-variant {
    background-color: transparent;
  }

  .header-variant__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-main);
    min-height: 72px;
    box-shadow: 0 6px 26px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  /* Current header-like background */
  .header-variant__bar--current {
    background-color: var(--color-white);
  }

  .header-variant__bar--current::before,
  .header-variant__bar--current::after {
    content: '';
    position: absolute;
    inset: 0;
    max-width: 260px;
    clip-path: polygon(0 0, 100% 0%, 80% 100%, 0% 100%);
  }

  .header-variant__bar--current::before {
    background: var(--color-gradient-100);
    z-index: -1;
  }

  .header-variant__bar--current::after {
    background: var(--color-blue-600);
    transform: translateX(22px);
    z-index: -2;
  }

  /* Solid blue header */
  .header-variant__bar--solid-blue {
    background: linear-gradient(
      90deg,
      var(--color-blue-600),
      var(--color-blue-500)
    );
  }

  /* Dark header */
  .header-variant__bar--dark {
    background: radial-gradient(circle at top left, #3b4b9b 0%, #050820 70%);
  }

  /* Light header */
  .header-variant__bar--light {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 71, 171, 0.15);
    box-shadow: 0 10px 30px rgba(0, 71, 171, 0.12);
  }

  /* Soft blue header */
  .header-variant__bar--blue-soft {
    background: linear-gradient(
      90deg,
      var(--color-blue-100),
      var(--color-blue-200)
    );
  }

  /* Blue accent header */
  .header-variant__bar--blue-accent {
    background: linear-gradient(
      90deg,
      var(--color-blue-500),
      var(--color-blue-700)
    );
    position: relative;
  }

  .header-variant__bar--blue-accent::before {
    content: '';
    position: absolute;
    right: -40px;
    top: -20px;
    width: 220px;
    height: 140px;
    background: rgba(255, 255, 255, 0.12);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .header-variant__logo {
    height: 32px;
    width: auto;
  }

  .header-variant__nav {
    display: flex;
    gap: 0.5rem;
  }

  .header-variant__nav span {
    width: 42px;
    height: 6px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.8);
  }

  .header-variant__label {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-blue-500);
  }

  @media (max-width: 768px) {
    .header-variants {
      padding-block: 1.5rem 2.5rem;
    }
  }
</style>
